# Dependencies (reinstalled by `npm install`)
node_modules/

# Native projects, generated by Expo on every build
/ios
/android

# Build output
*.apk
*.aab
modules/*/android/build/
dist/
web-build/

# Big binaries, downloaded by `npm run setup`
modules/moonshine-stt/models/
modules/moonshine-stt/ios/Frameworks/

# Expo and Metro caches
.expo/
expo-env.d.ts
.metro-health-check*

# Local databases (the app creates its own on each device)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite

# Signing keys and secrets
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision
.env*.local

# Editors, tools and OS clutter
.claude/
.vscode/
.idea/
.kotlin/
.DS_Store
*.orig.*
*.tsbuildinfo

# Logs
npm-debug.*
yarn-debug.*
yarn-error.*
